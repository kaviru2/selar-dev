{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Friendly, careful research tool. A small linnet carries a page between what you read now and what you read before; you decide whether the link holds.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.122,
          0.318,
          0.208
        ],
        "hex": "#1f5135"
      }
    },
    "primary-mid": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.357,
          0.541,
          0.435
        ],
        "hex": "#5b8a6f"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.09,
          0.165
        ],
        "hex": "#0f172a"
      }
    },
    "slate": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.278,
          0.333,
          0.412
        ],
        "hex": "#475569"
      }
    },
    "slate-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2,
          0.255,
          0.333
        ],
        "hex": "#334155"
      }
    },
    "mist": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.945,
          0.961,
          0.976
        ],
        "hex": "#f1f5f9"
      }
    },
    "paper": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.992,
          0.973
        ],
        "hex": "#fffdf8"
      }
    },
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "sky": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.882,
          0.929,
          0.984
        ],
        "hex": "#e1edfb"
      }
    },
    "rust": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.706,
          0.325,
          0.165
        ],
        "hex": "#b4532a"
      }
    },
    "rust-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.604,
          0.263,
          0.133
        ],
        "hex": "#9a4322"
      }
    },
    "blush": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.984,
          0.929,
          0.902
        ],
        "hex": "#fbede6"
      }
    },
    "amber": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.851,
          0.467,
          0.024
        ],
        "hex": "#d97706"
      }
    },
    "sun": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.965,
          0.769,
          0.325
        ],
        "hex": "#f6c453"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fraunces",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.015,
          "unit": "em"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fraunces",
        "fontSize": {
          "value": 2.25,
          "unit": "rem"
        },
        "fontWeight": 650,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fraunces",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 650
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Figtree",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Figtree",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Figtree",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
