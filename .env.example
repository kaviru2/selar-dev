# SELAR — Environment Variables
# Copy to .env and fill in values for local development.

# --- Postgres ---
POSTGRES_USER=selar
POSTGRES_PASSWORD=selar_dev
POSTGRES_DB=selar

# --- Go API ---
DATABASE_URL=postgres://selar:selar_dev@postgres:5432/selar?sslmode=disable
# Set to production only with a unique JWT_SECRET. In production a remote
# DATABASE_URL must use sslmode=require (or verify-full); see docs/DEPLOYMENT.md.
APP_ENV=development
JWT_SECRET=dev-secret-change-in-production
CORS_ORIGIN=http://localhost:3000
PORT=8080
WORKER_URL=http://localhost:8000
# Serverless worker (Modal): shared secret sent as X-Selar-Worker-Secret on
# /jobs/trigger and /chat. Leave empty locally: the API then sends no triggers
# and the polling worker picks jobs up from the durable queue.
WORKER_TRIGGER_SECRET=
WORKER_TRIGGER_TIMEOUT=3s
# Serverless pgx pool bounds (Vercel). Defaults shown.
DB_MAX_CONNS=4
DB_MAX_CONN_IDLE_TIME=30s
DB_MAX_CONN_LIFETIME=5m

# --- Next.js Console ---
NEXT_PUBLIC_API_URL=http://localhost:8080
API_INTERNAL_URL=http://selar-api:8080

# --- Sign in with Google (optional; off unless all three are set) ---
# Web OAuth client from Google Cloud project selar-research-261008.
# Redirect URI to register: <console origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Drive import (Picker, drive.file scope). Browser API key restricted
# to picker.googleapis.com and the console's HTTP referrers. Needs the client
# id above; the import stays hidden unless both are set.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# --- Gemini AI (for embedding + LLM) ---
GEMINI_API_KEY=
GEMINI_MULTIMODAL_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=3072
GEMINI_TEXT_MODEL=models/gemini-3-flash-preview

# Maximum number of documents the worker processes simultaneously.
# Keep this at 1 for predictable memory usage with large PDFs.
# Queue polling is off by default for ad-hoc local uvicorn processes. Docker
# Compose enables it explicitly on the worker service.
INGESTION_QUEUE_ENABLED=false
INGESTION_CONCURRENCY=1

# --- Upload storage (shared by Go API and worker) ---
# local (default): files live in LOCAL_STORAGE_DIR, which Docker Compose shares
# between the API and worker through the selar_uploads volume.
# s3: any S3-compatible bucket (Cloudflare R2, Supabase Storage, AWS S3, MinIO).
# Required for Vercel + Modal: the browser uploads PDFs directly to the bucket
# with short-lived presigned URLs (avoids the ~4.5 MB function body limit).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/selar_uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and some S3-compatible providers that need path-style URLs.
S3_FORCE_PATH_STYLE=false
