# SELAR — Environment Variables
# Copy to .env and fill in values for local development.

# --- Postgres ---
POSTGRES_USER=selar
POSTGRES_PASSWORD=selar_dev
POSTGRES_DB=selar

# --- Go API ---
DATABASE_URL=postgres://selar:selar_dev@postgres:5432/selar?sslmode=disable
JWT_SECRET=dev-secret-change-in-production
CORS_ORIGIN=http://localhost:3000
PORT=8080
WORKER_URL=http://localhost:8000

# --- Next.js Console ---
NEXT_PUBLIC_API_URL=http://localhost:8080
API_INTERNAL_URL=http://selar-api:8080

# --- Gemini AI (for embedding + LLM) ---
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=models/gemini-3-flash-preview
