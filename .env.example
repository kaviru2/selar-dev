# SELAR — Environment Variables
# Copy to .env and fill in values for local development.

# --- Postgres ---
POSTGRES_USER=selar
POSTGRES_PASSWORD=selar_dev
POSTGRES_DB=selar

# --- Go API ---
DATABASE_URL=postgres://selar:selar_dev@postgres:5432/selar?sslmode=disable
# Set to production only with a unique JWT_SECRET.
APP_ENV=development
JWT_SECRET=dev-secret-change-in-production
CORS_ORIGIN=http://localhost:3000
PORT=8080
WORKER_URL=http://localhost:8000

# --- Next.js Console ---
NEXT_PUBLIC_API_URL=http://localhost:8080
API_INTERNAL_URL=http://selar-api:8080

# --- Gemini AI (for embedding + LLM) ---
GEMINI_API_KEY=
GEMINI_MULTIMODAL_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=3072
GEMINI_TEXT_MODEL=models/gemini-3-flash-preview

# Maximum number of documents the worker processes simultaneously.
# Keep this at 1 for predictable memory usage with large PDFs.
# Queue polling is off by default for ad-hoc local uvicorn processes. Docker
# Compose enables it explicitly on the worker service.
INGESTION_QUEUE_ENABLED=false
INGESTION_CONCURRENCY=1
